        { "level": 0, "start": 1, "format": "decimal", "text": "%1.", "suffix": "tab", "leftIndent": 12.7, "hangingIndent": 6.35 },
        { "level": 1, "start": 1, "format": "decimal", "text": "%1.%2", "suffix": "tab", "leftIndent": 19.05, "hangingIndent": 6.35 },
        { "level": 2, "start": 1, "format": "decimal", "text": "%1.%2.%3", "suffix": "tab", "leftIndent": 25.4, "hangingIndent": 6.35 },
        { "level": 3, "start": 1, "format": "decimal", "text": "%1.%2.%3.%4", "suffix": "tab", "leftIndent": 31.75, "hangingIndent": 6.35 }
      ]
    },
    "instances": {
      "heading": {
        "numId": 41,
        "kind": "heading"
      },
      "list": {
        "numId": 42,
        "kind": "list"
      }
    }
  },
  "table": {
    "borderColor": "808080",
    "borderSize": 4,
    "headerFill": "EDEDED",
    "headerBold": true,
    "cellMargin": 1.5
