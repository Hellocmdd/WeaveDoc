<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WeaveDoc.App.ViewModels"
        xmlns:views="using:WeaveDoc.App.Views"
        x:Class="WeaveDoc.App.Views.MainWindow"
        Width="1280"
        Height="820"
        MinWidth="1120"
        MinHeight="680"
        Title="WeaveDoc"
        Background="{DynamicResource ShellBackgroundBrush}">
  <Window.Styles>
    <Style Selector="Button.shell-tool">
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.shell-tool.active">
      <Setter Property="Background" Value="{DynamicResource ShellSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.shell-tool:disabled">
      <Setter Property="Foreground" Value="{DynamicResource ShellDisabledTextBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="TextBox.shell-search">
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{DynamicResource ShellInputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
    </Style>

    <Style Selector="Button:disabled:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TextBox:focus">
      <Setter Property="Background" Value="{DynamicResource ShellInputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource ShellSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
  </Window.Styles>

  <Grid x:Name="ShellRoot"
        x:DataType="vm:AppShellViewModel"
        RowDefinitions="32,36,*,22"
        Background="{DynamicResource ShellBackgroundBrush}"
        ClipToBounds="True">
    <Border x:Name="ShellTitleBar"
            Background="{DynamicResource ShellTitleBarBrush}"
            BorderBrush="{DynamicResource ShellSubtleBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,0">
      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10">
        <Grid Grid.Column="0"
              Width="16"
              Height="16"
              VerticalAlignment="Center"
              RowDefinitions="*,*"
              ColumnDefinitions="*,*"
              RowSpacing="2"
              ColumnSpacing="2">
          <Border Grid.Row="0" Grid.Column="0" CornerRadius="1" Background="{DynamicResource ShellAccentStrongBrush}" />
          <Border Grid.Row="0" Grid.Column="1" CornerRadius="1" Background="{DynamicResource ShellAccentBrush}" Opacity="0.75" />
          <Border Grid.Row="1" Grid.Column="0" CornerRadius="1" Background="{DynamicResource ShellAccentBrush}" Opacity="0.6" />
          <Border Grid.Row="1" Grid.Column="1" CornerRadius="1" Background="{DynamicResource ShellAccentStrongBrush}" Opacity="0.45" />
        </Grid>

        <TextBlock Grid.Column="1"
                   Text="WeaveDoc - 未打开文档"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource ShellTextBrush}"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Column="2"
                   Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource ShellMutedTextBrush}"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <Border x:Name="ShellCommandBar"
            Grid.Row="1"
            Background="{DynamicResource ShellChromeBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,220,Auto"
            ColumnSpacing="4">
        <TextBlock Grid.Column="0"
                   Text="文件"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource ShellMutedTextBrush}" />
        <Button x:Name="NewShellDocumentButton" Grid.Column="1" Classes="shell-tool" Content="新建" IsEnabled="False" />
        <Button x:Name="OpenShellDocumentButton" Grid.Column="2" Classes="shell-tool" Content="打开" IsEnabled="False" />
        <Button x:Name="SaveShellDocumentButton" Grid.Column="3" Classes="shell-tool" Content="保存" IsEnabled="False" />
        <Border Grid.Column="4" Width="1" Height="18" Background="{DynamicResource ShellBorderBrush}" VerticalAlignment="Center" />
        <Button x:Name="ExportShellDocumentButton" Grid.Column="5" Classes="shell-tool" Content="导出" IsEnabled="False" />
        <Border Grid.Column="6" Width="1" Height="18" Background="{DynamicResource ShellBorderBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="7"
                   Text="辅助"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource ShellMutedTextBrush}" />
        <Button x:Name="AiChatCommandButton"
                Grid.Column="8"
                Classes="shell-tool active"
                Content="问答"
                Click="OnSelectAiChatTabClick" />
        <Button x:Name="AiLiteratureCommandButton"
                Grid.Column="9"
                Classes="shell-tool"
                Content="文献"
                Click="OnSelectAiLiteratureTabClick" />
        <Button x:Name="AiSnapshotCommandButton"
                Grid.Column="10"
                Classes="shell-tool"
                Content="快照"
                Click="OnSelectAiSnapshotTabClick" />
        <Button x:Name="AiShellCommandButton"
                Grid.Column="11"
                Classes="shell-tool active"
                Content="{Binding AiPanelToggleText}"
                Click="OnToggleAiPanelClick" />
        <Border Grid.Column="12" Width="1" Height="18" Background="{DynamicResource ShellBorderBrush}" VerticalAlignment="Center" />
        <Button x:Name="SetupShellCommandButton" Grid.Column="14" Classes="shell-tool" Content="设置" IsEnabled="False" />
        <TextBox x:Name="ShellSearchBox"
                 Grid.Column="15"
                 Classes="shell-search"
                 Text=""
                 PlaceholderText="搜索待接入"
                 IsEnabled="False"
                 VerticalAlignment="Center" />
        <Button x:Name="ThemeMenuButton"
                Grid.Column="16"
                Classes="shell-tool active"
                Content="{Binding ThemeToggleText}"
                Click="OnToggleThemeClick" />
      </Grid>
    </Border>

    <Grid x:Name="ShellWorkspace"
          Grid.Row="2"
          Background="{DynamicResource ShellBackgroundBrush}"
          ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="300" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="3*" MinWidth="400" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="300" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <views:WorkspaceSidebar x:Name="WorkspaceSidebarControl"
                              Grid.Column="0" />

      <GridSplitter x:Name="LeftWorkspaceSplitter"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="False"
                    Background="{DynamicResource ShellBorderBrush}" />

      <views:EditorWorkspace x:Name="EditorWorkspaceControl"
                             Grid.Column="2" />

      <GridSplitter x:Name="RightWorkspaceSplitter"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="False"
                    Background="{DynamicResource ShellBorderBrush}" />

      <views:AiAssistantPanel x:Name="AiAssistantPanelControl"
                              Grid.Column="4" />
    </Grid>

    <views:ShellStatusBar x:Name="ShellStatusBarControl"
                          Grid.Row="3" />
  </Grid>
</Window>
