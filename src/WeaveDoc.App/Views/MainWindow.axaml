<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WeaveDoc.App.ViewModels"
        xmlns:views="using:WeaveDoc.App.Views"
        x:Class="WeaveDoc.App.Views.MainWindow"
        Width="1280"
        Height="820"
        MinWidth="1120"
        MinHeight="680"
        Title="WeaveDoc"
        Background="{DynamicResource ShellBackgroundBrush}">
  <Window.Styles>
    <Style Selector="Button.shell-tool">
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="9,1,9,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.shell-tool.active">
      <Setter Property="Background" Value="{DynamicResource ShellSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.shell-tool:disabled">
      <Setter Property="Foreground" Value="{DynamicResource ShellDisabledTextBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="TextBox.shell-search">
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{DynamicResource ShellInputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
    </Style>

    <Style Selector="Button:disabled:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TextBox:focus">
      <Setter Property="Background" Value="{DynamicResource ShellInputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource ShellSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
  </Window.Styles>

  <Grid x:Name="ShellRoot"
        x:DataType="vm:AppShellViewModel"
        RowDefinitions="36,44,*,24"
        Background="{DynamicResource ShellBackgroundBrush}"
        ClipToBounds="True">
    <Border x:Name="ShellTitleBar"
            Background="{DynamicResource ShellTitleBarBrush}"
            BorderBrush="{DynamicResource ShellSubtleBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,0">
      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10">
        <Grid Grid.Column="0"
              Width="18"
              Height="18"
              VerticalAlignment="Center"
              RowDefinitions="*,*"
              ColumnDefinitions="*,*"
              RowSpacing="2"
              ColumnSpacing="2">
          <Border Grid.Row="0" Grid.Column="0" CornerRadius="1" Background="{DynamicResource ShellAccentStrongBrush}" />
          <Border Grid.Row="0" Grid.Column="1" CornerRadius="1" Background="{DynamicResource ShellAccentBrush}" Opacity="0.75" />
          <Border Grid.Row="1" Grid.Column="0" CornerRadius="1" Background="{DynamicResource ShellAccentBrush}" Opacity="0.6" />
          <Border Grid.Row="1" Grid.Column="1" CornerRadius="1" Background="{DynamicResource ShellAccentStrongBrush}" Opacity="0.45" />
        </Grid>

        <TextBlock Grid.Column="1"
                   Text="WeaveDoc - 未打开文档"
                   VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ShellTextBrush}"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Column="2"
                   Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource ShellMutedTextBrush}"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <Border x:Name="ShellCommandBar"
            Grid.Row="1"
            Background="{DynamicResource ShellChromeBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,220,Auto"
            ColumnSpacing="6">
        <TextBlock Grid.Column="0"
                   Text="文件"
                   VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ShellMutedTextBrush}" />
        <Button x:Name="NewShellDocumentButton" Grid.Column="1" Classes="command-button" Click="OnNewDocumentClick">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Classes="shell-icon" Data="{StaticResource IconNew}" />
            <TextBlock Text="新建" />
          </StackPanel>
        </Button>
        <Button x:Name="OpenShellDocumentButton" Grid.Column="2" Classes="command-button" Click="OnOpenDocumentClick">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Classes="shell-icon" Data="{StaticResource IconOpen}" />
            <TextBlock Text="打开" />
          </StackPanel>
        </Button>
        <Button x:Name="SaveShellDocumentButton" Grid.Column="3" Classes="command-button" Click="OnSaveDocumentClick">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Classes="shell-icon" Data="{StaticResource IconSave}" />
            <TextBlock Text="保存" />
          </StackPanel>
        </Button>
        <Button x:Name="VersionHistoryCommandButton" Grid.Column="4" Classes="command-button" Click="OnOpenVersionHistoryClick">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Classes="shell-icon" Data="{StaticResource IconSnapshot}" />
            <TextBlock Text="历史" />
          </StackPanel>
        </Button>
        <Button x:Name="SetupShellCommandButton" Grid.Column="5" Classes="command-button" Click="OnOpenSettingsClick">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Classes="shell-icon" Data="{StaticResource IconSettings}" />
            <TextBlock Text="设置" />
          </StackPanel>
        </Button>
        <Border Grid.Column="6" Classes="panel-divider" />
        <Button x:Name="ExportShellDocumentButton" Grid.Column="7" Classes="command-button primary" Click="OnExportDocumentClick">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Classes="shell-icon" Data="{StaticResource IconExport}" />
            <TextBlock Text="导出" />
          </StackPanel>
        </Button>
        <Border Grid.Column="8" Classes="panel-divider" />
        <TextBlock Grid.Column="9"
                   Text="辅助"
                   VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ShellMutedTextBrush}" />
        <Button x:Name="AiChatCommandButton"
                Grid.Column="10"
                Classes="command-button active"
                Click="OnSelectAiChatTabClick">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Classes="shell-icon" Data="{StaticResource IconChat}" />
            <TextBlock Text="问答" />
          </StackPanel>
        </Button>
        <Button x:Name="AiLiteratureCommandButton"
                Grid.Column="11"
                Classes="command-button"
                Click="OnSelectAiLiteratureTabClick">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Classes="shell-icon" Data="{StaticResource IconLiterature}" />
            <TextBlock Text="文献" />
          </StackPanel>
        </Button>
        <Button x:Name="AiSnapshotCommandButton"
                Grid.Column="12"
                Classes="command-button"
                Click="OnSelectAiSnapshotTabClick">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Classes="shell-icon" Data="{StaticResource IconSnapshot}" />
            <TextBlock Text="快照" />
          </StackPanel>
        </Button>
        <Button x:Name="AiShellCommandButton"
                Grid.Column="13"
                Classes="command-button active"
                Content="{Binding AiPanelToggleText}"
                Click="OnToggleAiPanelClick" />
        <Border Grid.Column="14" Classes="panel-divider" />
        <Border Grid.Column="16"
                VerticalAlignment="Center"
                CornerRadius="{DynamicResource ShellRadiusMd}"
                Background="{DynamicResource ShellInputBrush}"
                BorderBrush="{DynamicResource ShellBorderBrush}"
                BorderThickness="1">
          <Panel>
            <Path Classes="shell-icon" Data="{StaticResource IconSearch}" Margin="8,0,0,0" VerticalAlignment="Center"
                  Stroke="{DynamicResource ShellMutedTextBrush}" />
            <TextBox x:Name="ShellSearchBox"
                     Classes="shell-field"
                     Text=""
                     PlaceholderText="搜索待接入"
                     IsEnabled="False"
                     BorderThickness="0"
                     Background="Transparent"
                     Margin="26,0,8,0"
                     VerticalAlignment="Center" />
          </Panel>
        </Border>
        <Button x:Name="ThemeMenuButton"
                Grid.Column="17"
                Classes="command-button active"
                Click="OnToggleThemeClick">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Classes="shell-icon" Data="{StaticResource IconSun}" />
            <TextBlock Text="{Binding ThemeToggleText}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid x:Name="ShellWorkspace"
          Grid.Row="2"
          Background="{DynamicResource ShellBackgroundBrush}"
          ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="300" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="3*" MinWidth="400" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="300" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <views:WorkspaceSidebar x:Name="WorkspaceSidebarControl"
                                IsVisible="{Binding IsMarkdownWorkspaceVisible}" />
        <views:PdfWorkspace x:Name="PdfWorkspaceControl"
                            IsVisible="{Binding IsPdfWorkspaceVisible}" />
      </Grid>

      <GridSplitter x:Name="LeftWorkspaceSplitter"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="False"
                    Background="{DynamicResource ShellBorderBrush}" />

      <views:EditorWorkspace x:Name="EditorWorkspaceControl"
                             Grid.Column="2"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch" />

      <GridSplitter x:Name="RightWorkspaceSplitter"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="False"
                    Background="{DynamicResource ShellBorderBrush}" />

      <views:AiAssistantPanel x:Name="AiAssistantPanelControl"
                              Grid.Column="4" />
    </Grid>

    <views:ShellStatusBar x:Name="ShellStatusBarControl"
                          Grid.Row="3" />
  </Grid>
</Window>
