<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeaveDoc.App.ViewModels"
             x:Class="WeaveDoc.App.Views.WorkspaceSidebar"
             x:DataType="vm:AppShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.preview-tool">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellDisabledTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.preview-tab">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.preview-tab.secondary">
      <Setter Property="Width" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellDisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="WorkspaceSidebarRoot"
        RowDefinitions="28,26,*"
        Background="{DynamicResource ShellPanelBrush}"
        ClipToBounds="True">
    <Border x:Name="DocumentPreviewToolbar"
            Grid.Row="0"
            Background="{DynamicResource ShellChromeBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="6,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto"
            ColumnSpacing="4">
        <Button x:Name="DocumentPreviousPageButton"
                Grid.Column="0"
                Classes="preview-tool"
                Content="&lt;"
                IsEnabled="False" />
        <TextBlock x:Name="DocumentPreviewPageText"
                   Grid.Column="1"
                   Text="0 / 0"
                   VerticalAlignment="Center"
                   FontSize="10"
                   FontFamily="monospace"
                   Foreground="{DynamicResource ShellMutedTextBrush}" />
        <Button x:Name="DocumentNextPageButton"
                Grid.Column="2"
                Classes="preview-tool"
                Content="&gt;"
                IsEnabled="False" />
        <Button x:Name="DocumentZoomOutButton"
                Grid.Column="4"
                Classes="preview-tool"
                Content="-"
                IsEnabled="False" />
        <TextBlock x:Name="DocumentPreviewZoomText"
                   Grid.Column="5"
                   Text="100%"
                   Width="38"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="10"
                   FontFamily="monospace"
                   Foreground="{DynamicResource ShellMutedTextBrush}" />
        <Button x:Name="DocumentZoomInButton"
                Grid.Column="6"
                Classes="preview-tool"
                Content="+"
                IsEnabled="False" />
      </Grid>
    </Border>

    <Border x:Name="DocumentPreviewTabStrip"
            Grid.Row="1"
            Background="{DynamicResource ShellChromeBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="4,0">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="DocumentPreviewTabButton"
                Classes="preview-tab"
                Content="未打开文档"
                IsEnabled="False"
                MinWidth="112" />
        <Button x:Name="DocumentPreviewCloseTabButton"
                Classes="preview-tab secondary"
                Content="x"
                IsEnabled="False" />
        <Button x:Name="DocumentPreviewAddTabButton"
                Classes="preview-tab secondary"
                Content="+"
                IsEnabled="False" />
      </StackPanel>
    </Border>

    <Border x:Name="DocumentPreviewCanvas"
            Grid.Row="2"
            Background="{DynamicResource ShellPaperWorkspaceBrush}"
            Padding="10">
      <Border x:Name="DocumentPreviewPaper"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{DynamicResource ShellInputBrush}"
              BorderBrush="{DynamicResource ShellBorderBrush}"
              BorderThickness="1"
              CornerRadius="4">
        <Grid RowDefinitions="*,Auto,Auto,*"
              RowSpacing="8"
              Margin="16">
          <TextBlock Grid.Row="1"
                     Text="文档预览"
                     HorizontalAlignment="Center"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ShellTextBrush}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="DocumentPreviewEmptyStateText"
                     Grid.Row="2"
                     Text="未打开 PDF 或 Markdown 文档"
                     HorizontalAlignment="Center"
                     MaxWidth="260"
                     FontSize="12"
                     Foreground="{DynamicResource ShellMutedTextBrush}"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
