<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeaveDoc.App.ViewModels"
             x:Class="WeaveDoc.App.Views.WorkspaceSidebar"
             x:DataType="vm:AppShellViewModel">
  <Grid x:Name="WorkspaceSidebarRoot"
        Background="{DynamicResource ShellPanelBrush}"
        ClipToBounds="True">
    <Border x:Name="DocumentPreviewCanvas"
            Grid.Row="2"
            Background="{DynamicResource ShellPaperWorkspaceBrush}"
            Padding="12">
      <Border x:Name="DocumentPreviewPaper"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{DynamicResource ShellInputBrush}"
              BorderBrush="{DynamicResource ShellBorderBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="*,Auto,Auto,Auto,*"
              RowSpacing="8"
              Margin="{StaticResource ShellSpace3}">
          <Border Grid.Row="1" Classes="empty-state-icon">
            <Path Classes="shell-icon" Data="{StaticResource IconOpen}" Width="17" Height="17"
                  Stroke="{DynamicResource ShellAccentBrush}" />
          </Border>
          <TextBlock Grid.Row="2"
                     Text="尚未打开文档"
                     HorizontalAlignment="Center"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ShellTextBrush}" />
          <TextBlock x:Name="DocumentPreviewEmptyStateText"
                     Grid.Row="3"
                     Text="从“打开”或拖拽 Markdown / PDF 到此处开始"
                     HorizontalAlignment="Center"
                     MaxWidth="240"
                     FontSize="12"
                     Foreground="{DynamicResource ShellMutedTextBrush}"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Border>
  </Grid>
</UserControl>
