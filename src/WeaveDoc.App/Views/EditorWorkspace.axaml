<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WeaveDoc.MarkdownEditor.Controls;assembly=WeaveDoc.MarkdownEditor"
             xmlns:vm="using:WeaveDoc.App.ViewModels"
             xmlns:views="using:WeaveDoc.App.Views"
             x:Class="WeaveDoc.App.Views.EditorWorkspace"
             x:DataType="vm:AppShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.editor-tab">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,1,12,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="{DynamicResource ShellEditorBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button.editor-mode">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,1,10,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.editor-mode.active">
      <Setter Property="Background" Value="{DynamicResource ShellSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    </Style>

    <Style Selector="Button.editor-tool">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellDisabledTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.editor-tab:disabled">
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.editor-mode:disabled">
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.editor-tool:disabled">
      <Setter Property="Foreground" Value="{DynamicResource ShellDisabledTextBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
    </Style>
    <Style Selector="Button.icon-button:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    </Style>
    <Style Selector="Button.icon-button:disabled">
      <Setter Property="Foreground" Value="{DynamicResource ShellDisabledTextBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="EditorWorkspaceRoot"
        RowDefinitions="34,38,*,28"
        Background="{DynamicResource ShellEditorBackgroundBrush}"
        ClipToBounds="True">
    <Border Grid.Row="0"
            Background="{DynamicResource ShellEditorPanelBrush}"
            BorderBrush="{DynamicResource ShellSubtleBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*">
        <Button Grid.Column="0"
                Classes="panel-tab active"
                Content="未打开文档"
                IsEnabled="False"
                IsVisible="{Binding HasNoDocument}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding CurrentDocumentSubtitle}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource ShellMutedTextBrush}"
                   TextTrimming="CharacterEllipsis"
                   Margin="10,0" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{DynamicResource ShellEditorPanelBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
            ColumnSpacing="6"
            Margin="10,0">
        <Button x:Name="Heading1Button"
                Grid.Column="0"
                Classes="icon-button"
                Content="H1"
                IsEnabled="{Binding IsMarkdownEditorVisible}"
                Click="OnHeading1Click" />
        <Button x:Name="Heading2Button"
                Grid.Column="1"
                Classes="icon-button"
                Content="H2"
                IsEnabled="{Binding IsMarkdownEditorVisible}"
                Click="OnHeading2Click" />
        <Border Grid.Column="2" Classes="panel-divider" />
        <Button x:Name="BoldButton"
                Grid.Column="3"
                Classes="icon-button"
                Content="B"
                IsEnabled="{Binding IsMarkdownEditorVisible}"
                Click="OnBoldClick" />
        <Button x:Name="ItalicButton"
                Grid.Column="4"
                Classes="icon-button"
                Content="I"
                IsEnabled="{Binding IsMarkdownEditorVisible}"
                Click="OnItalicClick" />
        <Border Grid.Column="5" Classes="panel-divider" />
        <Button x:Name="BulletListButton"
                Grid.Column="6"
                Classes="icon-button"
                Content="-"
                IsEnabled="{Binding IsMarkdownEditorVisible}"
                Click="OnBulletListClick" />
        <Button x:Name="TaskListButton"
                Grid.Column="7"
                Classes="icon-button"
                Content="[]"
                IsEnabled="{Binding IsMarkdownEditorVisible}"
                Click="OnTaskListClick" />
        <Button x:Name="WordWrapToggleButton"
                Grid.Column="9"
                Classes="segment-button"
                Classes.active="{Binding IsWordWrapEnabled}"
                Content="自动换行"
                ToolTip.Tip="自动换行 (Alt+Z)"
                IsEnabled="{Binding IsMarkdownEditorVisible}"
                Click="OnWordWrapToggleClick" />
        <Border Grid.Column="10"
                Background="{DynamicResource ShellInputBrush}"
                BorderBrush="{DynamicResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="2"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="EditModeButton"
                    Classes="segment-button"
                    Classes.active="{Binding IsEditModeSelected}"
                    Content="编辑"
                    ToolTip.Tip="编辑 (Ctrl+Shift+V)"
                    Click="OnEditModeClick" />
            <Button x:Name="PreviewModeButton"
                    Classes="segment-button"
                    Classes.active="{Binding IsPreviewModeSelected}"
                    Content="预览"
                    ToolTip.Tip="预览 (Ctrl+Shift+V)"
                    Click="OnPreviewModeClick" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Background="{DynamicResource ShellEditorBackgroundBrush}"
            Padding="18">
      <Border Classes="workspace-surface">
        <Grid>
          <Grid x:Name="EditorEmptyState"
                RowDefinitions="*,Auto,Auto,*"
                RowSpacing="8"
                IsVisible="{Binding IsEditorEmptyStateVisible}">
            <TextBlock x:Name="CurrentDocumentTitleText"
                       Grid.Row="1"
                       Text="{Binding CurrentDocumentTitle}"
                       HorizontalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellTextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="EditorEmptyStateText"
                       Grid.Row="2"
                       Text="{Binding EmptyDocumentText}"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource ShellMutedTextBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="360" />
          </Grid>

          <controls:NativeMarkdownEditorControl x:Name="MarkdownEditorControl"
                                                IsVisible="{Binding IsMarkdownEditorVisible}" />

          <controls:PreviewWebViewControl x:Name="MarkdownPreviewControl"
                                          IsVisible="{Binding IsMarkdownPreviewVisible}"
                                          HtmlContent="{Binding DocumentWorkspace.PreviewHtml}"
                                          SourceFilePath="{Binding DocumentWorkspace.CurrentFilePath}"
                                          ViewerCssTheme="{Binding Theme}" />

          <Grid x:Name="PreviewEmptyState"
                RowDefinitions="*,Auto,Auto,*"
                RowSpacing="8"
                IsVisible="{Binding IsPreviewEmptyStateVisible}">
            <TextBlock Grid.Row="1"
                       Text="预览"
                       HorizontalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellTextBrush}" />
            <TextBlock x:Name="PreviewEmptyStateText"
                       Grid.Row="2"
                       Text="{Binding EmptyPreviewText}"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource ShellMutedTextBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="360" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border Grid.Row="3"
            Background="{DynamicResource ShellEditorPanelBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
            ColumnSpacing="8">
        <TextBlock Grid.Column="0"
                   Text="{Binding ModeStatusText}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource ShellMutedTextBrush}" />
        <TextBlock Grid.Column="1"
                   Text=">"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource ShellBorderBrush}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding PendingCommandText}"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource ShellMutedTextBrush}" />
        <Button x:Name="ExportDocumentButton"
                Grid.Column="4"
                Classes="segment-button"
                Content="导出"
                IsEnabled="False"
                MinWidth="52" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
