<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeaveDoc.App.ViewModels"
             x:Class="WeaveDoc.App.Views.ShellStatusBar"
             x:DataType="vm:AppShellViewModel">
  <Border x:Name="ShellStatusBarRoot"
          Height="22"
          Background="{DynamicResource ShellChromeBrush}"
          BorderBrush="{DynamicResource ShellBorderBrush}"
          BorderThickness="0,1,0,0"
          Padding="8,0">
    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto"
          ColumnSpacing="8">
      <TextBlock Grid.Column="0"
                 Text="WeaveDoc"
                 VerticalAlignment="Center"
                 FontSize="10"
                 Foreground="{DynamicResource ShellTextBrush}"
                 FontWeight="SemiBold" />
      <TextBlock Grid.Column="1"
                 Text="|"
                 VerticalAlignment="Center"
                 FontSize="10"
                 Foreground="{DynamicResource ShellBorderBrush}" />
      <TextBlock Grid.Column="2"
                 Text="{Binding ModeStatusText}"
                 VerticalAlignment="Center"
                 FontSize="10"
                 Foreground="{DynamicResource ShellMutedTextBrush}"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="4"
                 Text="{Binding StatusText}"
                 VerticalAlignment="Center"
                 FontSize="10"
                 Foreground="{DynamicResource ShellMutedTextBrush}"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="5"
                 Text="{Binding CurrentDocumentTitle}"
                 VerticalAlignment="Center"
                 FontSize="10"
                 Foreground="{DynamicResource ShellMutedTextBrush}"
                 TextTrimming="CharacterEllipsis"
                 MaxWidth="160" />
      <Button x:Name="ThemeToggleButton"
              Grid.Column="6"
              Content="{Binding ThemeToggleText}"
              Click="OnToggleThemeClick"
              Background="{DynamicResource ShellInputBrush}"
              Foreground="{DynamicResource ShellTextBrush}"
              BorderBrush="{DynamicResource ShellBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Height="18"
              Padding="8,0"
              FontSize="10" />
    </Grid>
  </Border>
</UserControl>
