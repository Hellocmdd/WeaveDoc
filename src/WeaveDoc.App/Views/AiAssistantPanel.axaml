<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeaveDoc.App.ViewModels"
             x:Class="WeaveDoc.App.Views.AiAssistantPanel"
             x:DataType="vm:AppShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.ai-tab">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button.ai-tab.active">
      <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    </Style>

    <Style Selector="Button.ai-command">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="{DynamicResource ShellRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellDisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="AiAssistantPanelRoot"
        RowDefinitions="30,Auto,*,Auto"
        Background="{DynamicResource ShellPanelBrush}"
        IsVisible="{Binding IsAiPanelExpanded}"
        ClipToBounds="True">
    <Border Grid.Row="0"
            Background="{DynamicResource ShellChromeBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*">
        <Button x:Name="AiChatTabButton"
                Grid.Column="0"
                Classes="ai-tab active"
                Content="问答"
                Click="OnSelectAiChatTabClick" />
        <Button x:Name="AiLiteratureTabButton"
                Grid.Column="1"
                Classes="ai-tab"
                Content="文献"
                Click="OnSelectAiLiteratureTabClick" />
        <Button x:Name="AiSnapshotTabButton"
                Grid.Column="2"
                Classes="ai-tab"
                Content="快照"
                Click="OnSelectAiSnapshotTabClick" />
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="8"
          Margin="10,10,10,8">
      <StackPanel Grid.Column="0"
                  Spacing="4">
        <TextBlock x:Name="AiPanelTitleText"
                   Text="{Binding AiPanelTitleText}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ShellTextBrush}"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal"
                    Spacing="6">
          <Border Width="7"
                  Height="7"
                  CornerRadius="4"
                  Background="{DynamicResource ShellDisabledTextBrush}"
                  VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}"
                     FontSize="10"
                     Foreground="{DynamicResource ShellMutedTextBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>

      <Button x:Name="ToggleAiPanelButton"
              Grid.Column="1"
              Classes="ai-command"
              Content="{Binding AiPanelToggleText}"
              Click="OnToggleAiPanelClick"
              IsEnabled="True" />
    </Grid>

    <Border Grid.Row="2"
            Margin="10,0"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            Background="{DynamicResource ShellInputBrush}"
            Padding="14">
      <Grid RowDefinitions="*,Auto,*"
            RowSpacing="8">
        <TextBlock x:Name="AiPanelEmptyStateText"
                   Grid.Row="1"
                   Text="{Binding AiPanelEmptyStateText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ShellTextBrush}"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border Grid.Row="3"
            Background="{DynamicResource ShellChromeBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10">
      <Grid RowDefinitions="Auto,Auto"
            RowSpacing="8">
        <TextBox x:Name="AiPromptInput"
                 Grid.Row="0"
                 Text=""
                 PlaceholderText="问答功能待接入"
                 IsEnabled="False"
                 AcceptsReturn="False"
                 TextWrapping="Wrap"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource ShellBorderBrush}"
                 Background="{DynamicResource ShellInputBrush}"
                 Foreground="{DynamicResource ShellTextBrush}"
                 Padding="10,8"
                 FontSize="12" />
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8">
          <TextBlock Grid.Column="0"
                     Text="{Binding PendingCommandText}"
                     VerticalAlignment="Center"
                     FontSize="10"
                     Foreground="{DynamicResource ShellMutedTextBrush}" />
          <Button x:Name="ClearAiConversationButton"
                  Grid.Column="1"
                  Classes="ai-command"
                  Content="清空"
                  IsEnabled="False" />
          <Button x:Name="SendAiPromptButton"
                  Grid.Column="2"
                  Classes="ai-command"
                  Content="发送"
                  IsEnabled="False" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
