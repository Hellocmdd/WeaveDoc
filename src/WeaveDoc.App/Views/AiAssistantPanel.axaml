<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeaveDoc.App.ViewModels"
             xmlns:views="using:WeaveDoc.App.Views"
             x:Class="WeaveDoc.App.Views.AiAssistantPanel"
             x:DataType="vm:AppShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.ai-tab">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,1,10,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button.ai-tab.active">
      <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="AiAssistantPanelRoot"
        RowDefinitions="36,*"
        Background="{DynamicResource ShellPanelBrush}"
        IsVisible="{Binding IsAiPanelExpanded}"
        ClipToBounds="True">
    <Border Grid.Row="0"
            Background="{DynamicResource ShellChromeBrush}"
            BorderBrush="{DynamicResource ShellBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
        <Button x:Name="AiChatTabButton"
                Grid.Column="0"
                Classes="panel-tab active"
                Content="问答"
                Click="OnSelectAiChatTabClick" />
        <Button x:Name="AiLiteratureTabButton"
                Grid.Column="1"
                Classes="panel-tab"
                Content="文献"
                Click="OnSelectAiLiteratureTabClick" />
        <Button x:Name="AiCorpusTabButton"
                Grid.Column="2"
                Classes="panel-tab"
                Content="语料"
                Click="OnSelectAiCorpusTabClick" />
        <Button x:Name="AiSnapshotTabButton"
                Grid.Column="3"
                Classes="panel-tab"
                Content="检索"
                Click="OnSelectAiSnapshotTabClick" />
        <Border x:Name="ProviderBadgeBorder"
                Grid.Column="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="6,0,8,0"
                Padding="8,2"
                Background="{DynamicResource ShellCardBrush}"
                BorderBrush="{DynamicResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                ToolTip.Tip="{Binding RagTabViewModel.ProviderBadgeToolTip}">
          <TextBlock x:Name="ProviderBadgeTextBlock"
                     Text="{Binding RagTabViewModel.ProviderBadgeText}"
                     FontSize="10"
                     FontWeight="SemiBold"
                     MaxWidth="150"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource ShellTextBrush}" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <views:RagChatView x:Name="ChatView" />
      <views:LiteratureView x:Name="LiteratureView"
                            IsVisible="False" />
      <views:RagCorpusView x:Name="CorpusView"
                           IsVisible="False" />
      <views:RagSnapshotView x:Name="SnapshotView"
                             IsVisible="False" />
    </Grid>
  </Grid>
</UserControl>
