<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- Smooth pointer-over/active transitions. Without these the brush swap
         is instantaneous, which reads as a hard "flash to grey". -->
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.command-button">
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,1,12,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ShellAccentHoverGhostBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentHoverGhostBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellRadiusMd}" />
  </Style>
  <Style Selector="Button.command-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource ShellAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.command-button.active">
    <Setter Property="Background" Value="{DynamicResource ShellSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
  </Style>
  <Style Selector="Button.command-button.primary">
    <Setter Property="Background" Value="{DynamicResource ShellAccentStrongBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.command-button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource ShellAccentHoverStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentHoverStrongBrush}" />
  </Style>
  <Style Selector="Button.command-button:disabled">
    <Setter Property="Foreground" Value="{DynamicResource ShellDisabledTextBrush}" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <Style Selector="Button.icon-button">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0,1,0,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ShellAccentHoverGhostBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentHoverGhostBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellRadiusMd}" />
  </Style>
  <Style Selector="Button.icon-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource ShellAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentStrongBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.icon-button:disabled">
    <Setter Property="Foreground" Value="{DynamicResource ShellDisabledTextBrush}" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <Style Selector="Button.segment-button">
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,1,12,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource ShellAccentHoverGhostBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellRadiusMd}" />
  </Style>
  <Style Selector="Button.segment-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource ShellAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellAccentStrongBrush}" />
  </Style>
  <Style Selector="Button.segment-button.active">
    <Setter Property="Background" Value="{DynamicResource ShellSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <Style Selector="Button.panel-tab">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="12,1,12,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.panel-tab:pointerover">
    <Setter Property="Background" Value="{DynamicResource ShellHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
  </Style>
  <Style Selector="Button.panel-tab.active">
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBox.shell-field">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="{DynamicResource ShellInputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellRadiusMd}" />
  </Style>
  <Style Selector="TextBox.shell-field:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.panel-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
  </Style>
  <Style Selector="TextBlock.meta-text">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
  </Style>
  <Style Selector="Border.panel-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Background" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.workspace-surface">
    <Setter Property="Background" Value="{DynamicResource ShellInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellRadiusLg}" />
  </Style>

  <Style Selector="Border.empty-state-card">
    <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellRadiusLg}" />
    <Setter Property="Padding" Value="{StaticResource ShellSpace3}" />
  </Style>
  <Style Selector="Border.empty-state-icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellRadiusMd}" />
    <Setter Property="Background" Value="{DynamicResource ShellInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.ai-bubble">
    <Setter Property="CornerRadius" Value="{DynamicResource ShellRadiusMd}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Border.ai-bubble.user">
    <Setter Property="Background" Value="{DynamicResource ShellCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.ai-bubble.ai">
    <Setter Property="Background" Value="{DynamicResource ShellSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.status-pill">
    <Setter Property="Background" Value="{DynamicResource ShellInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ShellRadiusSm}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
</Styles>
