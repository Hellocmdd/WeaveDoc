<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="WeaveDoc.MarkdownEditor.Controls.NativeMarkdownEditorControl">
    <!-- The editor surface is always dark by design. Pin the subtree to the Dark theme variant so
         AvaloniaEdit's text-area background / caret / selection render for a dark surface even when
         the application is in the Light variant (otherwise text renders low-contrast in light theme). -->
    <ThemeVariantScope RequestedThemeVariant="Dark">
        <Grid>
            <AvaloniaEdit:TextEditor Name="Editor"
                                     ShowLineNumbers="True"
                                     WordWrap="False"
                                     FontFamily="Noto Sans Mono CJK SC,monospace"
                                     FontSize="14"
                                     Background="#1E1E1E"
                                     Foreground="#D4D4D4"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto" />
            <TextBox x:Name="PlainTextFallbackEditor"
                     IsVisible="False"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Noto Sans Mono CJK SC,monospace"
                     FontSize="14"
                     Background="#1E1E1E"
                     Foreground="#D4D4D4"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
    </ThemeVariantScope>
</UserControl>
