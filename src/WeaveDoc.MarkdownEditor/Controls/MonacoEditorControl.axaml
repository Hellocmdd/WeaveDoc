<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WeaveDoc.MarkdownEditor.Controls.MonacoEditorControl"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <Grid>
    <Border x:Name="HostBorder"
            Background="#1E1E1E"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
    <TextBox x:Name="EditorFallbackTextBox"
             IsVisible="False"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             FontFamily="Consolas, monospace"
             FontSize="14"
             Background="#1E1E1E"
             Foreground="#F4F4F4"
             BorderThickness="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch" />
  </Grid>
</UserControl>
